# Assumes compatibility with both bash and zsh
# === Editor and Notes Convenience Setups ===
export TERM=xterm-256color

export NOTES="$HOME/Dropbox/Apps/NotationalVelocity"     # notes folder for scripting access
export EDITOR="$(which vim)"                             # use vim for simple editing

# === PATH editing ===
export PATH="/usr/local/bin:$PATH"                      # local binaries
export PATH="/usr/local/yum:$PATH"                      # yum stuff, random things rely on it
export PATH="/usr/local/share/npm/bin:$PATH"            # npm global
export PATH="$HOME/.local/bin:$PATH"                    # other local binaries
export PATH="$HOME/.npm-packages/bin:$PATH"             # npm explicit-set global
export PATH="$HOME/.npm-global/bin:$PATH"               # npm global prefix (linux)
export PATH="/usr/local/go/bin:$PATH"                   # add go to path
export PATH="/usr/local/terraform/bin:$PATH"            # terraform directory
export PATH="$HOME/.cargo/bin:$PATH"                    # rust cargo directory
export PATH="$HOME/dotfiles/scripts:$PATH"              # my own custom scripts

# === Language-specific setups ===
export ANDROID_HOME="$HOME/Library/Android/sdk"         # Android
export ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"         # Android
export GOPATH="$HOME/Dev/Go"                            # Golang
export NVM_DIR="$HOME/.nvm"                             # NVM directory

# === Language-dependent paths ===
export PATH="$PATH:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools"

# Environment manager initializations
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"  # This loads nvm

case "$(uname -s)" in
  Darwin)
    export JAVA_HOME="$("/usr/libexec/java_home")"  # Java for Android Studio
    if [ "$(uname -m)" = "arm64" ]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
      export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
      export PATH="$(gem environment gemdir)/bin:$PATH"
    fi
    ;;
  Linux) : ;;
esac

# Source .env if it exists in our dotfiles
[ -f "$HOME/dotfiles/.env" ] && . "$HOME/dotfiles/.env"

# --- per-machine commit signing (opt-in, self-healing) ---
# Enable SSH commit signing ONLY where it actually works, and only in the
# untracked ~/.gitconfig.local overlay. The tracked .gitconfig stays
# signing-free so machines without a usable key/binary never have their
# pulls/rebases/merges broken by a failed sign. Capable machines sign and
# show "Verified"; others quietly skip.
git_cfg_local() { git config --file "$HOME/.gitconfig.local" "$@"; }

signing_key=""
for k in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
  [ -f "$k" ] && signing_key="$k" && break
done

# Test-sign non-interactively (no passphrase prompt can hang shell startup).
if [ -n "$signing_key" ] && command -v ssh-keygen >/dev/null 2>&1 &&
   SSH_ASKPASS=/usr/bin/false SSH_ASKPASS_REQUIRE=force \
   printf 'test' | ssh-keygen -Y sign -n git -f "$signing_key" >/dev/null 2>&1; then
  git_cfg_local commit.gpgsign true
  git_cfg_local gpg.format ssh
  git_cfg_local user.signingkey "$signing_key"
else
  # Don't let a stale overlay keep forcing signs on a now-incapable machine.
  git_cfg_local --unset commit.gpgsign 2>/dev/null || true
fi
unset signing_key k
# --- end signing ---

# Language-specific paths, require language-specific setups
export PATH="$GOPATH/bin:$PATH"                         # add go binaries

# === Shell completion ===
# zsh: bundled `_git` from $fpath is autoloaded by compinit.
# bash: source bash-completion if installed (lazy-loads git and many others).
#       Install via `brew install bash-completion@2` or your distro's package.
if [ -n "${BASH_VERSION-}" ]; then
  for _bc in \
    "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh" \
    "/usr/share/bash-completion/bash_completion"; do
    [ -r "$_bc" ] && . "$_bc" && break
  done
  unset _bc
elif [ -n "${ZSH_VERSION-}" ]; then
  autoload -Uz compinit && compinit
fi
